---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BidAnalytics from '../../components/BidAnalytics.astro';
import { supabase } from '../../lib/supabase';
import { getDetailUrl } from '../../lib/bid-urls';

// 모든 입찰 공고 (active + closed)
const { data: allBids } = await supabase
  .from('bid_notices')
  .select('*')
  .order('reg_date', { ascending: false })
  .limit(200);

// 모든 낙찰 결과
const { data: allResults } = await supabase
  .from('bid_results')
  .select('*, bid_notices(title, org_name, source, region, estimated_price)')
  .order('award_date', { ascending: false })
  .limit(200);

// AI 요약 데이터
const { data: allSummaries } = await supabase
  .from('bid_summaries_public')
  .select('*');

const summaryMap = new Map(
  (allSummaries || []).map((s: any) => [s.bid_notice_id, s])
);

const bids = allBids || [];
const results = allResults || [];

// 통계
const activeBids = bids.filter(b => b.status === 'active');
const closedBids = bids.filter(b => b.status === 'closed');
const totalEstimated = bids.reduce((sum, b) => sum + (b.estimated_price || 0), 0);

// 지역 추출 (첫 단어 = 광역시/도 약칭)
const regionMap: Record<string, string> = {};
bids.forEach(b => {
  if (!b.region) return;
  const parts = b.region.split(' ');
  if (parts.length >= 2) {
    const key = parts[0];
    const label = parts[1]?.replace(/특별자치도|특별자치시|광역시|특별시/, '') || key;
    regionMap[key] = parts[1] || key;
  }
});
const regions = Object.entries(regionMap).sort((a, b) => a[1].localeCompare(b[1], 'ko'));

// 출처 목록
const sources = [...new Set(bids.map(b => b.source))].sort();

// 상위 수주 업체
const companyStats: Record<string, { count: number; totalPrice: number }> = {};
results.forEach(r => {
  const name = r.company_name;
  if (!companyStats[name]) companyStats[name] = { count: 0, totalPrice: 0 };
  companyStats[name].count++;
  companyStats[name].totalPrice += (r.award_price || 0);
});
const topCompanies = Object.entries(companyStats)
  .sort((a, b) => b[1].count - a[1].count || b[1].totalPrice - a[1].totalPrice)
  .slice(0, 10);

// 유틸리티
const formatPrice = (price: number | null) => {
  if (!price) return '-';
  if (price >= 100000000) return `${(price / 100000000).toFixed(1)}억`;
  if (price >= 10000) return `${Math.round(price / 10000).toLocaleString()}만`;
  return `${price.toLocaleString()}원`;
};

const formatFullPrice = (price: number | null) => {
  if (!price) return '-';
  return `${price.toLocaleString()}원`;
};

const formatDate = (dateStr: string | null) => {
  if (!dateStr) return '-';
  return new Date(dateStr).toLocaleDateString('ko-KR', { month: 'short', day: 'numeric' });
};

const getDday = (deadline: string | null) => {
  if (!deadline) return null;
  const diff = Math.ceil((new Date(deadline).getTime() - Date.now()) / (1000 * 60 * 60 * 24));
  if (diff < 0) return null;
  if (diff === 0) return 'D-Day';
  return `D-${diff}`;
};

const sourceLabels: Record<string, string> = {
  g2b: '나라장터', kapt: 'K-APT', d2b: '국방조달', lofin: '지자체', alio: 'ALIO', kwater: 'K-water', lh: 'LH'
};

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;

const getRegionShort = (region: string | null) => {
  if (!region) return '';
  const parts = region.split(' ');
  return parts.length >= 3 ? parts[parts.length - 1] : parts[0];
};

const getRegionProvince = (region: string | null) => {
  if (!region) return '';
  return region.split(' ')[0] || '';
};

---

<BaseLayout
  title="데크 입찰정보 | 데크센터"
  description="데크, 목재, 조경 관련 공공 입찰 공고와 낙찰 결과를 실시간으로 확인하세요."
>
  <!-- 페이지 헤더 -->
  <div class="page-header">
    <h1>데크 입찰정보</h1>
    <p>나라장터 · K-APT · 지방재정365에서 수집한 데크 관련 공공 입찰 공고</p>
  </div>

  <!-- 통계 대시보드 -->
  <div class="stats-bar">
    <div class="stat-card">
      <span class="stat-value">{activeBids.length}</span>
      <span class="stat-label">진행중 공고</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{closedBids.length}</span>
      <span class="stat-label">완료된 계약</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{results.length}</span>
      <span class="stat-label">낙찰 결과</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{formatPrice(totalEstimated)}</span>
      <span class="stat-label">총 추정가</span>
    </div>
  </div>

  <!-- 통계 차트 토글 -->
  <div class="analytics-toggle-wrap">
    <button class="analytics-toggle-btn" id="analyticsToggle">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 20V10M12 20V4M6 20v-6"/>
      </svg>
      통계 보기
    </button>
  </div>

  <BidAnalytics />

  <!-- 필터 바 -->
  <div class="filter-section">
    <div class="filter-bar">
      <div class="filter-group">
        <label class="filter-label">검색</label>
        <input
          type="text"
          id="searchInput"
          class="search-input"
          placeholder="공사명, 기관명으로 검색..."
        />
      </div>
      <div class="filter-group">
        <label class="filter-label">출처</label>
        <div class="source-tabs" id="sourceTabs">
          <button class="source-tab active" data-source="all">전체</button>
          {sources.map(s => (
            <button class={`source-tab src-${s}`} data-source={s}>{sourceLabels[s] || s}</button>
          ))}
        </div>
      </div>
      <div class="filter-group">
        <label class="filter-label">지역</label>
        <select id="regionFilter" class="region-select">
          <option value="all">전체 지역</option>
          {regions.map(([key, label]) => (
            <option value={key}>{label}</option>
          ))}
        </select>
      </div>
      <div class="filter-group">
        <label class="filter-label">상태</label>
        <select id="statusFilter" class="region-select">
          <option value="all">전체</option>
          <option value="active">진행중</option>
          <option value="closed">마감</option>
        </select>
      </div>
    </div>
    <div class="filter-result" id="filterResult">
      총 <strong>{bids.length}</strong>건의 공고
    </div>
  </div>

  <!-- 입찰 공고 목록 -->
  <section class="bid-section" id="bidSection">
    {bids.length === 0 ? (
      <div class="empty">
        <p>수집된 데크 관련 입찰 공고가 없습니다.</p>
        <p class="sub">매일 자동으로 수집되며, 새 공고가 등록되면 여기에 표시됩니다.</p>
      </div>
    ) : (
      <div class="bid-list" id="bidList">
        {bids.map((bid) => {
          const dday = getDday(bid.deadline);
          const regionShort = getRegionShort(bid.region);
          const regionProvince = getRegionProvince(bid.region);
          return (
            <article
              class={`bid-card ${bid.status === 'closed' ? 'is-closed' : 'is-active'}`}
              data-source={bid.source}
              data-region={regionProvince}
              data-status={bid.status}
              data-title={bid.title?.toLowerCase() || ''}
              data-org={bid.org_name?.toLowerCase() || ''}
            >
              <div class="bid-top">
                <div class="bid-badges">
                  <span class={`source-badge src-${bid.source}`}>{sourceLabels[bid.source] || bid.source}</span>
                  {bid.status === 'active' && <span class="status-badge active">진행중</span>}
                  {bid.status === 'closed' && <span class="status-badge closed">마감</span>}
                </div>
                {dday && <span class={`dday ${dday === 'D-Day' ? 'today' : ''}`}>{dday}</span>}
                {bid.status === 'closed' && !dday && bid.reg_date && (
                  <span class="reg-date">{formatDate(bid.reg_date)}</span>
                )}
              </div>

              <h3 class="bid-title">
                {getDetailUrl(bid) ? (
                  <a href={getDetailUrl(bid)!} target="_blank" rel="noopener noreferrer">
                    {bid.title}
                    <svg class="external-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                ) : (
                  <span class="no-link">{bid.title}</span>
                )}
              </h3>

              <div class="bid-info">
                {bid.org_name && (
                  <div class="info-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 7v14m18-14v14M6 11h.01M6 15h.01M12 11h.01M12 15h.01M18 11h.01M18 15h.01M6 7V3h12v4"/></svg>
                    <span>{bid.org_name}</span>
                  </div>
                )}
                {regionShort && (
                  <div class="info-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span>{regionShort}</span>
                  </div>
                )}
                {bid.bid_method && (
                  <div class="info-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    <span>{bid.bid_method}</span>
                  </div>
                )}
              </div>

              {bid.estimated_price && (
                <div class="bid-price">
                  <span class="price-label">추정가</span>
                  <span class="price-value">{formatFullPrice(bid.estimated_price)}</span>
                  <span class="price-short">({formatPrice(bid.estimated_price)})</span>
                </div>
              )}

              {bid.matched_keywords && bid.matched_keywords.length > 0 && (
                <div class="bid-keywords">
                  {bid.matched_keywords.map((kw: string) => (
                    <span class="kw-tag">{kw}</span>
                  ))}
                </div>
              )}

              {summaryMap.has(bid.id) && (
                <div class="ai-summary">
                  <button class="summary-toggle" aria-expanded="false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 014 4c0 1.7-1 3-2.4 3.7L14 10v1h-4v-1l-.4-.3A4 4 0 0112 2zM9 14h6M10 18h4"/></svg>
                    AI 요약
                  </button>
                  <div class="summary-content" hidden>
                    {summaryMap.get(bid.id).key_summary && (
                      <div class="sf-row">
                        <span class="sf-label">핵심</span>
                        <p class="sf-value">{summaryMap.get(bid.id).key_summary}</p>
                      </div>
                    )}
                    {summaryMap.get(bid.id).material_types?.length > 0 && (
                      <div class="sf-row">
                        <span class="sf-label">자재</span>
                        <div class="sf-tags">
                          {summaryMap.get(bid.id).material_types.map((m: string) => (
                            <span class="sf-tag">{m}</span>
                          ))}
                        </div>
                      </div>
                    )}
                    {summaryMap.get(bid.id).qualifications?.length > 0 && (
                      <div class="sf-row">
                        <span class="sf-label">자격</span>
                        <p class="sf-value">{summaryMap.get(bid.id).qualifications.join(', ')}</p>
                      </div>
                    )}
                    {summaryMap.get(bid.id).project_scale && (
                      <div class="sf-row">
                        <span class="sf-label">규모</span>
                        <p class="sf-value">{summaryMap.get(bid.id).project_scale}</p>
                      </div>
                    )}
                  </div>
                </div>
              )}

              <div class="bid-footer">
                {bid.deadline && (
                  <span class="footer-date">마감 {formatDate(bid.deadline)}</span>
                )}
                {!bid.deadline && bid.reg_date && (
                  <span class="footer-date">등록 {formatDate(bid.reg_date)}</span>
                )}
                <div class="bid-links">
                  {bid.file_url && <a href={bid.file_url} class="link-file" target="_blank" rel="noopener noreferrer">첨부파일</a>}
                  {getDetailUrl(bid) && <a href={getDetailUrl(bid)!} class="link-detail" target="_blank" rel="noopener noreferrer">상세보기 →</a>}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>

  <!-- 시뮬레이터 연결 배너 -->
  <section class="simulator-banner">
    <div class="banner-content">
      <div class="banner-text">
        <span class="banner-badge">시뮬레이터</span>
        <h2>입찰 준비에 시뮬레이터를 활용하세요</h2>
        <p>3D 설계 + 자동 견적으로 제안서 퀄리티를 높이고, 최적의 자재 조합으로 경쟁력 있는 가격을 제시하세요.</p>
        <ul class="banner-features">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            3D 설계 도면으로 제안서 차별화
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            자재별 비용 비교로 최적 견적 산출
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            PDF 도면 + 자재 리스트 즉시 다운로드
          </li>
        </ul>
        <a href="/simulator" class="banner-cta">
          시뮬레이터로 설계하기
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="banner-visual">
        <div class="visual-mockup">
          <div class="mockup-header">
            <span class="mockup-dot"></span>
            <span class="mockup-dot"></span>
            <span class="mockup-dot"></span>
          </div>
          <div class="mockup-body">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4">
              <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 002 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
            <span>3D 시뮬레이터</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 낙찰 결과 -->
  <section class="bid-section">
    <h2 class="section-heading">
      <span class="heading-icon result-icon"></span>
      최근 낙찰 결과
      <span class="heading-count">{results.length}건</span>
    </h2>

    {results.length === 0 ? (
      <div class="empty">
        <p>아직 수집된 낙찰 결과가 없습니다.</p>
      </div>
    ) : (
      <div class="result-grid">
        {results.slice(0, 30).map((r) => {
          const notice = (r as any).bid_notices;
          return (
            <article class="result-card">
              <div class="result-top">
                <span class="result-company">{r.company_name}</span>
                {r.award_date && <time class="result-date">{formatDate(r.award_date)}</time>}
              </div>
              <p class="result-title">{notice?.title || `공고 ${r.bid_num}`}</p>
              <div class="result-details">
                {notice?.org_name && <span class="result-org">{notice.org_name}</span>}
                {notice?.region && <span class="result-region">{getRegionShort(notice.region)}</span>}
              </div>
              <div class="result-numbers">
                {r.award_price && (
                  <div class="result-price">
                    <span class="rp-label">낙찰가</span>
                    <span class="rp-value">{formatPrice(r.award_price)}</span>
                  </div>
                )}
                {r.award_rate && (
                  <div class="result-rate">
                    <span class="rp-label">낙찰률</span>
                    <span class="rp-value">{r.award_rate}%</span>
                  </div>
                )}
                {r.award_price && notice?.estimated_price && notice.estimated_price > 0 && (
                  <div class="result-ratio">
                    <span class="rp-label">예가대비</span>
                    <span class="rp-value">{((r.award_price / notice.estimated_price) * 100).toFixed(1)}%</span>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>

  <!-- 주요 수주 업체 -->
  {topCompanies.length > 0 && (
    <section class="bid-section">
      <h2 class="section-heading">
        <span class="heading-icon company-icon"></span>
        주요 수주 업체
        <span class="heading-count">최근 수주 기준</span>
      </h2>
      <div class="company-grid">
        {topCompanies.map(([name, stats], i) => (
          <div class="company-card">
            <div class="company-rank">#{i + 1}</div>
            <div class="company-info">
              <span class="company-name">{name}</span>
              <div class="company-stats">
                <span>{stats.count}건 수주</span>
                {stats.totalPrice > 0 && <span>총 {formatPrice(stats.totalPrice)}</span>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- 이메일 알림 구독 -->
  <section class="subscribe-section">
    <div class="subscribe-card">
      <div class="subscribe-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </div>
      <h2>새 입찰 공고를 이메일로 받아보세요</h2>
      <p>관심 키워드와 지역을 선택하면, 매칭되는 새 입찰 공고가 등록될 때 이메일로 알려드립니다.</p>
      <form class="subscribe-form" id="subscribeForm" data-api-url={`${supabaseUrl}/functions/v1/subscribe`}>
        <div class="keyword-options">
          <span class="keyword-label">관심 키워드</span>
          <div class="keyword-chips">
            <label class="kw-chip"><input type="checkbox" name="keywords" value="데크" checked /> 데크</label>
            <label class="kw-chip"><input type="checkbox" name="keywords" value="합성목" checked /> 합성목</label>
            <label class="kw-chip"><input type="checkbox" name="keywords" value="방부목" /> 방부목</label>
            <label class="kw-chip"><input type="checkbox" name="keywords" value="조경시설" /> 조경시설</label>
            <label class="kw-chip"><input type="checkbox" name="keywords" value="파고라" /> 파고라</label>
            <label class="kw-chip"><input type="checkbox" name="keywords" value="수변데크" /> 수변데크</label>
          </div>
        </div>
        <div class="region-row">
          <span class="keyword-label">관심 지역</span>
          <select id="subscribeRegion" class="subscribe-select">
            <option value="">전국 (전체)</option>
            {regions.map(([key, label]) => (
              <option value={key}>{label}</option>
            ))}
          </select>
        </div>
        <div class="form-row">
          <input
            type="email"
            id="subscribeEmail"
            class="subscribe-input"
            placeholder="이메일 주소를 입력하세요"
            required
          />
          <button type="submit" class="subscribe-btn">
            <span class="btn-text">구독하기</span>
            <span class="btn-loading">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin">
                <path d="M21 12a9 9 0 11-6.219-8.56"/>
              </svg>
            </span>
          </button>
        </div>
        <p class="subscribe-note">무료 · 언제든 구독 취소 가능 · 스팸 없음</p>
      </form>
      <div class="subscribe-success" id="subscribeSuccess">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <span>구독이 완료되었습니다! 새 입찰 공고가 등록되면 알려드리겠습니다.</span>
      </div>
      <div class="subscribe-error" id="subscribeError">
        <span>구독 처리 중 오류가 발생했습니다. 잠시 후 다시 시도해주세요.</span>
