<!-- 클라이언트 사이드 필터링 -->
<script>
  document.addEventListener('astro:page-load', () => {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const sourceTabs = document.getElementById('sourceTabs');
    const regionFilter = document.getElementById('regionFilter') as HTMLSelectElement;
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
    const filterResult = document.getElementById('filterResult');
    const bidList = document.getElementById('bidList');

    if (!bidList) return;

    const cards = Array.from(bidList.querySelectorAll('.bid-card')) as HTMLElement[];
    let activeSource = 'all';

    function applyFilters() {
      const query = searchInput?.value.toLowerCase().trim() || '';
      const region = regionFilter?.value || 'all';
      const status = statusFilter?.value || 'all';
      let visible = 0;

      cards.forEach(card => {
        const cardSource = card.dataset.source || '';
        const cardRegion = card.dataset.region || '';
        const cardStatus = card.dataset.status || '';
        const cardTitle = card.dataset.title || '';
        const cardOrg = card.dataset.org || '';

        let show = true;

        if (activeSource !== 'all' && cardSource !== activeSource) show = false;
        if (region !== 'all' && cardRegion !== region) show = false;
        if (status !== 'all' && cardStatus !== status) show = false;
        if (query && !cardTitle.includes(query) && !cardOrg.includes(query)) show = false;

        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (filterResult) {
        filterResult.innerHTML = `총 <strong>${visible}</strong>건의 공고`;
      }
    }

    // 출처 탭 클릭
    sourceTabs?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.source-tab') as HTMLElement;
      if (!btn) return;
      sourceTabs.querySelectorAll('.source-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      activeSource = btn.dataset.source || 'all';
      applyFilters();
    });

    // 필터 변경
    searchInput?.addEventListener('input', applyFilters);
    regionFilter?.addEventListener('change', applyFilters);
    statusFilter?.addEventListener('change', applyFilters);

    // 이메일 구독 폼
    const subscribeForm = document.getElementById('subscribeForm') as HTMLFormElement;
    const subscribeSuccess = document.getElementById('subscribeSuccess');
    const subscribeError = document.getElementById('subscribeError');

    subscribeForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('subscribeEmail') as HTMLInputElement;
      const submitButton = subscribeForm.querySelector('.subscribe-btn') as HTMLButtonElement;
      const regionSelect = document.getElementById('subscribeRegion') as HTMLSelectElement;

      if (!emailInput?.value) return;

      submitButton?.classList.add('is-loading');
      subscribeError?.classList.remove('is-visible');

      const keywords = Array.from(
        subscribeForm.querySelectorAll<HTMLInputElement>('input[name="keywords"]:checked')
      ).map(cb => cb.value);

      const regions = regionSelect?.value ? [regionSelect.value] : [];

      try {
        const apiUrl = subscribeForm.dataset.apiUrl;
        const res = await fetch(apiUrl!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value, keywords, regions }),
        });

        if (!res.ok) throw new Error('Failed');

        subscribeForm.classList.add('is-hidden');
        subscribeSuccess?.classList.add('is-visible');
      } catch {
        subscribeError?.classList.add('is-visible');
      } finally {
        submitButton?.classList.remove('is-loading');
      }
    });

    // AI 요약 토글
    document.querySelectorAll('.summary-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const content = btn.nextElementSibling as HTMLElement;
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        if (content) content.hidden = expanded;
      });
    });

    // URL에 unsubscribe 토큰이 있으면 처리
    const urlParams = new URLSearchParams(window.location.search);
    const unsubToken = urlParams.get('unsubscribed');
    if (unsubToken === 'true') {
      const banner = document.getElementById('unsubscribeBanner');
      banner?.classList.add('is-visible');
    }
  });
</script>

