---
---

<section class="hero" aria-label="메인 히어로">
  <div class="hero-inner">
    <span class="hero-kicker">
      <span class="hero-kicker-dot"></span>
      견적 시뮬레이터
    </span>
    <h1 class="hero-headline">
      데크 비용,<br />
      더 이상 감으로<br />
      잡지 마세요.
    </h1>
    <p class="hero-sub">
      면적, 자재, 시공 방식을 입력하면<br />
      최적 자재 조합과 정확한 견적을 3분 안에 받아보세요.
    </p>
    <div class="hero-actions">
      <a href="https://calc.deckctr.com" class="btn btn-primary hero-cta-primary">
        무료 견적 시뮬레이션 시작
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="#process" class="hero-cta-secondary">
        작동 방식 보기
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </a>
    </div>

    <!-- CSS-only 견적 시뮬레이터 목업 UI -->
    <div class="hero-mockup" aria-hidden="true">
      <div class="mockup-header">
        <span class="mockup-dot"></span>
        <span class="mockup-dot"></span>
        <span class="mockup-dot"></span>
        <span class="mockup-title">견적 시뮬레이터</span>
      </div>
      <div class="mockup-body">
        <div class="mockup-row">
          <span class="mockup-label">면적</span>
          <span class="mockup-field">
            <span class="mockup-value">35</span>
            <span class="mockup-unit">㎡</span>
          </span>
        </div>
        <div class="mockup-row">
          <span class="mockup-label">자재</span>
          <span class="mockup-field">
            <span class="mockup-value">합성목 (WPC)</span>
          </span>
        </div>
        <div class="mockup-row">
          <span class="mockup-label">견적</span>
          <span class="mockup-field mockup-result">
            <span class="mockup-value accent">₩ 4,250,000</span>
          </span>
        </div>
        <div class="mockup-chart">
          <svg viewBox="0 0 200 40" preserveAspectRatio="none" class="mockup-chart-svg">
            <polyline points="0,35 30,28 60,30 90,18 120,22 150,10 180,14 200,5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="currentColor" stop-opacity="0.15"/>
              <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
            </linearGradient>
            <polyline points="0,35 30,28 60,30 90,18 120,22 150,10 180,14 200,5 200,40 0,40" fill="url(#chart-fill)"/>
          </svg>
        </div>
      </div>
    </div>

    <p class="hero-trust" aria-live="polite">
      <span class="hero-trust-dot"></span>
      <span class="hero-trust-count" data-count="2400">0</span>+ 건의 시뮬레이션 완료
    </p>
  </div>
</section>

<script>
  import { heroEntrance, countUp } from '../lib/animations';

  function initHero() {
    heroEntrance([
      '.hero-kicker',
      '.hero-headline',
      '.hero-sub',
      '.hero-actions',
      '.hero-mockup',
      '.hero-trust',
    ], 0.3);

    const countEl = document.querySelector('.hero-trust-count');
    if (countEl) {
      const target = Number(countEl.getAttribute('data-count') || 0);
      countUp(countEl, target);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: 120px 0 80px;
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* Radial gradient background */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% 40%,
        color-mix(in srgb, var(--color-accent) 5%, transparent),
        transparent
      );
    pointer-events: none;
  }

  /* Decorative glow orb */
  .hero::after {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle,
      color-mix(in srgb, var(--color-accent) 7%, transparent),
      transparent 70%
    );
    right: -200px;
    top: -100px;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-width-narrow);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    text-align: center;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 1rem;
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent-border);
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: 2rem;
  }

  .hero-kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse-dot 2s infinite;
  }

  .hero-headline {
    font-size: var(--font-size-6xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: var(--letter-spacing-tighter);
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: var(--max-width-text);
    margin: 0 auto 2.5rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: var(--radius-md);
    font-size: var(--font-size-base);
    font-weight: 600;
    box-shadow: var(--shadow-accent);
    transition: all var(--transition-base);
  }

  .hero-cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    font-weight: 500;
    transition: color var(--transition-base);
  }

  .hero-cta-secondary:hover {
    color: var(--color-text);
  }

  /* Mockup UI */
  .hero-mockup {
    max-width: 420px;
    margin: 0 auto 3rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    text-align: left;
  }

  .mockup-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .mockup-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-warm-300);
  }

  .mockup-title {
    margin-left: auto;
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    font-weight: 500;
  }

  .mockup-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mockup-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
  }

  .mockup-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    font-weight: 500;
  }

  .mockup-field {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    font-weight: 500;
  }

  .mockup-unit {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-xs);
    margin-left: 2px;
  }

  .mockup-result {
    font-weight: 700;
  }

  .mockup-value.accent {
    color: var(--color-accent);
  }

  .mockup-chart {
    padding: 8px 12px 4px;
    margin-top: 2px;
  }

  .mockup-chart-svg {
    width: 100%;
    height: 32px;
    color: var(--color-accent);
  }

  .hero-trust {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  .hero-trust-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-trust-count {
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 120px 0 64px;
    }

    .hero-headline {
      font-size: clamp(2.5rem, 8vw, 3.5rem);
    }

    .hero-sub br {
      display: none;
    }

    .hero-actions {
      flex-direction: column;
      gap: 1rem;
    }

    .hero-mockup {
      max-width: 100%;
    }
  }
</style>
