---
const steps = [
  {
    number: '1',
    title: '면적 입력',
    description: '시공할 공간의 면적과 형태를 입력하세요.',
    icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/><path d="M15 15l3 3M15 18l3-3"/></svg>',
  },
  {
    number: '2',
    title: '자재 선택',
    description: 'AI가 추천한 최적 자재 조합을 확인하거나 직접 선택하세요.',
    icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
  },
  {
    number: '3',
    title: '견적 확인',
    description: '자재비, 시공비, 부자재까지 포함된 정확한 견적서를 받으세요.',
    icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>',
  },
];
---

<section class="process" id="process" aria-labelledby="process-heading">
  <div class="process-inner">
    <div class="process-header">
      <h2 id="process-heading">간단한 3단계</h2>
      <p>복잡한 데크 견적, 이렇게 쉬워집니다</p>
    </div>

    <div class="process-steps">
      {steps.map((step, i) => (
        <>
          <div class="process-step">
            <span class="process-number">{step.number}</span>
            <div class="process-icon" set:html={step.icon} />
            <h3 class="process-title">{step.title}</h3>
            <p class="process-desc">{step.description}</p>
          </div>
          {i < steps.length - 1 && <div class="process-connector" aria-hidden="true"></div>}
        </>
      ))}
    </div>

    <div class="process-cta">
      <a href="https://calc.deckctr.com" class="btn btn-primary">
        지금 시뮬레이션 시작하기
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { staggerReveal } from '../lib/animations';

  function initProcess() {
    staggerReveal('.process-steps', '.process-step');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProcess);
  } else {
    initProcess();
  }
  document.addEventListener('astro:page-load', initProcess);
</script>

<style>
  .process {
    padding: var(--section-spacing) 0;
    background: var(--color-accent-soft);
  }

  .process-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .process-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .process-header h2 {
    font-size: var(--font-size-h2);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    letter-spacing: var(--letter-spacing-tight);
  }

  .process-header p {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
  }

  .process-steps {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 0;
    align-items: start;
    text-align: center;
    margin-bottom: 56px;
  }

  .process-connector {
    display: flex;
    align-items: center;
    height: 56px;
    padding: 0 8px;
  }

  .process-connector::before {
    content: '';
    display: block;
    width: 48px;
    height: 2px;
    background: linear-gradient(to right, var(--color-accent-border), var(--color-accent), var(--color-accent-border));
  }

  .process-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
    background: var(--color-bg);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-xl);
    padding: 32px 24px;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-slow), transform var(--transition-slow);
  }

  .process-step:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .process-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 1.125rem;
    font-weight: 700;
    color: white;
    background: var(--color-accent);
    margin-bottom: 1rem;
  }

  .process-icon {
    color: var(--color-accent);
    opacity: 0.7;
    margin-bottom: 1rem;
  }

  .process-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .process-desc {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 240px;
  }

  .process-cta {
    text-align: center;
  }

  .process-cta .btn {
    padding: 1rem 2rem;
    box-shadow: var(--shadow-accent);
    transition: all var(--transition-base);
  }

  .process-cta .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  @media (max-width: 768px) {
    .process-steps {
      display: flex;
      flex-direction: column;
      gap: 16px;
      text-align: left;
    }

    .process-connector {
      height: auto;
      padding: 0;
      justify-content: center;
    }

    .process-connector::before {
      width: 2px;
      height: 24px;
    }

    .process-step {
      flex-direction: row;
      align-items: flex-start;
      gap: 1rem;
      padding: 20px;
    }

    .process-number {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
      margin-bottom: 0;
    }

    .process-icon {
      display: none;
    }

    .process-desc {
      max-width: none;
    }
  }
</style>
