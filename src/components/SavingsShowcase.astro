---
const savingsCases = [
  {
    title: '주택 베란다 데크',
    area: '20㎡',
    original: 850,
    optimized: 680,
  },
  {
    title: '옥상 루프탑 데크',
    area: '45㎡',
    original: 2100,
    optimized: 1720,
  },
  {
    title: '카페 테라스 데크',
    area: '35㎡',
    original: 1560,
    optimized: 1280,
  },
];
---

<section id="savings" class="savings-showcase" aria-labelledby="savings-heading">
  <div class="savings-inner">
    <div class="section-header">
      <h2 id="savings-heading" class="text-h2 font-bold text-text mb-3">이렇게 절감했습니다</h2>
      <p class="text-lg text-text-secondary">AI가 분석한 최적 자재 조합으로 불필요한 비용을 줄였습니다</p>
    </div>

    <div class="savings-grid">
      {savingsCases.map((item) => {
        const saved = item.original - item.optimized;
        const percent = Math.round((saved / item.original) * 100);
        return (
          <article class="savings-card">
            <div class="savings-header">
              <h3 class="savings-title">{item.title}</h3>
              <span class="savings-area">{item.area}</span>
            </div>
            <div class="savings-comparison">
              <div class="savings-row original">
                <span class="savings-label">원래 견적</span>
                <span class="savings-value">{item.original}만원</span>
              </div>
              <div class="savings-arrow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 5v14M5 12l7 7 7-7"/>
                </svg>
              </div>
              <div class="savings-row optimized">
                <span class="savings-label">시뮬레이터 추천</span>
                <span class="savings-value">{item.optimized}만원</span>
              </div>
            </div>
            <div class="savings-result">
              <span class="savings-saved">{saved}만원 절감</span>
              <span class="savings-percent">-{percent}%</span>
            </div>
          </article>
        );
      })}
    </div>

    <div class="savings-cta">
      <a href="/simulator" class="btn-primary">
        내 프로젝트 절감액 확인하기
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .savings-showcase {
    background: var(--color-bg-secondary);
    padding: var(--section-spacing) 0;
  }

  .savings-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .savings-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .savings-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: 28px;
    border: 1px solid var(--color-warm-200);
    transition: all var(--transition-base);
  }

  .savings-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent-light);
  }

  .savings-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .savings-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .savings-area {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-tertiary);
    background: var(--color-warm-50);
    padding: 4px 10px;
    border-radius: var(--radius-md);
  }

  .savings-comparison {
    margin-bottom: 20px;
  }

  .savings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-radius: var(--radius-md);
  }

  .savings-row.original {
    background: var(--color-warm-50);
  }

  .savings-row.optimized {
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .savings-label {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .savings-value {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .savings-row.original .savings-value {
    text-decoration: line-through;
    color: var(--color-text-tertiary);
  }

  .savings-row.optimized .savings-value {
    color: var(--color-accent);
  }

  .savings-arrow {
    display: flex;
    justify-content: center;
    padding: 8px 0;
    color: var(--color-text-tertiary);
  }

  .savings-result {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--color-accent) 10%, transparent) 0%,
      color-mix(in srgb, var(--color-accent-light) 10%, transparent) 100%
    );
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .savings-saved {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .savings-percent {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-accent);
  }

  .savings-cta {
    text-align: center;
    margin-top: 48px;
  }

  @media (max-width: 900px) {
    .savings-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .savings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
