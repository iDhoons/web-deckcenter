---
import { supabase } from '../lib/supabase';
import { getDetailUrl } from '../lib/bid-urls';

// 활성 입찰 건수 조회
const { count: activeCount } = await supabase
  .from('bid_notices')
  .select('*', { count: 'exact', head: true })
  .eq('status', 'active');

// 최신 3건 조회
const { data: bids } = await supabase
  .from('bid_notices')
  .select('id, title, org_name, region, estimated_price, deadline, detail_url, source, bid_num, raw_data')
  .eq('status', 'active')
  .order('reg_date', { ascending: false })
  .limit(3);

function getDday(deadline: string) {
  const diff = Math.ceil((new Date(deadline).getTime() - Date.now()) / (1000 * 60 * 60 * 24));
  if (diff === 0) return 'D-Day';
  if (diff > 0) return `D-${diff}`;
  return '마감';
}

function formatPrice(price: number | null) {
  if (!price) return '-';
  if (price >= 100000000) return `${(price / 100000000).toFixed(1)}억`;
  if (price >= 10000) return `${Math.round(price / 10000).toLocaleString()}만원`;
  return `${price.toLocaleString()}원`;
}

const displayCount = activeCount ?? 0;
---

<section class="bids-preview" aria-labelledby="bids-preview-heading">
  <div class="bids-inner">
    <div class="section-header">
      <h2 id="bids-preview-heading" class="text-h2 font-bold text-text mb-3">
        지금 <span class="bids-count">{displayCount}</span>건의 데크 공사 입찰 진행 중
      </h2>
      <p class="text-lg text-text-secondary">공공기관 및 아파트 단지의 데크 공사 입찰 정보를 실시간으로 확인하세요</p>
    </div>

    {bids && bids.length > 0 ? (
      <div class="bids-grid">
        {bids.map((bid) => (
          <article class="bid-card">
            <div class="bid-card-header">
              <span class={`bid-dday ${getDday(bid.deadline) === 'D-Day' ? 'urgent' : ''}`}>
                {getDday(bid.deadline)}
              </span>
              <span class="bid-source">{bid.source}</span>
            </div>
            <h3 class="bid-title">
              {getDetailUrl(bid) ? (
                <a href={getDetailUrl(bid)!} target="_blank" rel="noopener noreferrer">
                  {bid.title}
                </a>
              ) : (
                bid.title
              )}
            </h3>
            <div class="bid-meta">
              {bid.org_name && (
                <span class="bid-meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  </svg>
                  {bid.org_name}
                </span>
              )}
              {bid.region && (
                <span class="bid-meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  {bid.region}
                </span>
              )}
              {bid.estimated_price && (
                <span class="bid-meta-item price">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                  </svg>
                  {formatPrice(bid.estimated_price)}
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="bids-empty text-center text-text-secondary">현재 진행 중인 입찰이 없습니다.</p>
    )}

    <div class="bids-footer">
      <a href="/bids" class="guide-link">
        전체 입찰 정보 보기
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .bids-preview {
    background: var(--color-bg);
    padding: var(--section-spacing) 0;
  }

  .bids-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .bids-count {
    color: var(--color-accent);
  }

  .bids-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .bid-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: 24px;
    border: 1px solid var(--color-warm-200);
    transition: all var(--transition-base);
  }

  .bid-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent-light);
  }

  .bid-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .bid-dday {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    font-weight: 700;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
  }

  .bid-dday.urgent {
    background: color-mix(in srgb, #ef4444 10%, transparent);
    color: #ef4444;
  }

  .bid-source {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
  }

  .bid-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 16px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bid-title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .bid-title a:hover {
    color: var(--color-accent);
  }

  .bid-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bid-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
  }

  .bid-meta-item.price {
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .bids-empty {
    padding: 48px 0;
  }

  .bids-footer {
    text-align: center;
    margin-top: 48px;
  }

  .guide-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-accent);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .guide-link:hover {
    gap: 12px;
    color: var(--color-accent-light);
  }

  @media (max-width: 900px) {
    .bids-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .bids-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
